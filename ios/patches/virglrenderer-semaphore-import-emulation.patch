+      else if (!strcmp(props->extensionName, "VK_KHR_external_semaphore_fd")) {
+         /* VKR_NO_SEMAPHORE_FD: as a host without it (for trying the emulation) */
+         if (getenv("VKR_NO_SEMAPHORE_FD"))
+            continue;
+         physical_dev->KHR_external_semaphore_fd = true;
+      }
       else if (!strcmp(props->extensionName, "VK_EXT_image_drm_format_modifier"))
          physical_dev->EXT_image_drm_format_modifier = true;
       else if (!strcmp(props->extensionName, "VK_EXT_queue_family_foreign"))
@@ -315,6 +321,8 @@ vkr_physical_device_init_extensions(struct vkr_physical_device *physical_dev)
    emulated_count += 2 * physical_dev->is_dma_buf_emulated;
    emulated_count += !physical_dev->EXT_image_drm_format_modifier;
    emulated_count += !physical_dev->EXT_queue_family_foreign;
+   physical_dev->is_semaphore_fd_emulated = !physical_dev->KHR_external_semaphore_fd;
+   emulated_count += physical_dev->is_semaphore_fd_emulated;
    exts = realloc(exts, sizeof(*exts) * (advertised_count + emulated_count));
    if (physical_dev->is_dma_buf_emulated) {
       strcpy(prop.extensionName, VK_EXT_EXTERNAL_MEMORY_DMA_BUF_EXTENSION_NAME);
@@ -329,6 +337,11 @@ vkr_physical_device_init_extensions(struct vkr_physical_device *physical_dev)
       prop.specVersion = vkr_extension_get_spec_version(prop.extensionName);
       exts[advertised_count++] = prop;
    }
+   if (physical_dev->is_semaphore_fd_emulated) {
+      strcpy(prop.extensionName, VK_KHR_EXTERNAL_SEMAPHORE_FD_EXTENSION_NAME);
+      prop.specVersion = vkr_extension_get_spec_version(prop.extensionName);
+      exts[advertised_count++] = prop;
+   }
    if (!physical_dev->EXT_queue_family_foreign) {
       /* FIXME: we don't actually emulate this yet as MoltenVK ignores queue family transfers... */
       strcpy(prop.extensionName, VK_EXT_QUEUE_FAMILY_FOREIGN_EXTENSION_NAME);
@@ -917,6 +930,18 @@ vkr_dispatch_vkGetPhysicalDeviceExternalSemaphoreProperties(
    struct vn_physical_device_proc_table *vk = &physical_dev->proc_table;
 
    vn_replace_vkGetPhysicalDeviceExternalSemaphoreProperties_args_handle(args);
+   if (physical_dev->is_semaphore_fd_emulated) {
+      /* importable only: the guest then does not offer its applications the
+       * extension, and uses it itself for a swapchain's signaled semaphores */
+      const bool sync_fd = args->pExternalSemaphoreInfo->handleType ==
+                           VK_EXTERNAL_SEMAPHORE_HANDLE_TYPE_SYNC_FD_BIT;
+      args->pExternalSemaphoreProperties->exportFromImportedHandleTypes = 0;
+      args->pExternalSemaphoreProperties->compatibleHandleTypes =
