+      args->pExternalSemaphoreProperties->externalSemaphoreFeatures =
+         sync_fd ? VK_EXTERNAL_SEMAPHORE_FEATURE_IMPORTABLE_BIT : 0;
+      return;
+   }
    vk->GetPhysicalDeviceExternalSemaphoreProperties(args->physicalDevice,
                                                     args->pExternalSemaphoreInfo,
                                                     args->pExternalSemaphoreProperties);
diff --git a/src/venus/vkr_physical_device.h b/src/venus/vkr_physical_device.h
index d51c9f4..1e4a4f3 100644
--- a/src/venus/vkr_physical_device.h
+++ b/src/venus/vkr_physical_device.h
@@ -29,6 +29,13 @@ struct vkr_physical_device {
 
    bool KHR_external_fence_fd;
 
+   /* Henge: the host cannot import a semaphore from a sync file (MoltenVK has no
+    * VK_KHR_external_semaphore_fd), which older guest drivers (Mesa before 26.2)
+    * require for a swapchain. All they import is an already signaled payload,
+    * which is emulated by signaling the semaphore from an empty submission. */
+   bool KHR_external_semaphore_fd;
+   bool is_semaphore_fd_emulated;
+
    bool EXT_external_memory_host;
 
    VkPhysicalDeviceMemoryProperties memory_properties;
diff --git a/src/venus/vkr_queue.c b/src/venus/vkr_queue.c
index 91f6ec3..e0fd072 100644
--- a/src/venus/vkr_queue.c
+++ b/src/venus/vkr_queue.c
@@ -598,6 +598,29 @@ vkr_dispatch_vkImportSemaphoreResourceMESA(
    /* resourceId 0 is for importing a signaled payload to sync_fd fence */
    assert(!res_info->resourceId);
 
+   if (dev->physical_device->is_semaphore_fd_emulated) {
+      /* Henge: no sync file import on this host. A signaled payload for the next
+       * wait is what an empty submission that signals the semaphore leaves. */
+      VkResult result = VK_ERROR_UNKNOWN;
+      if (!list_is_empty(&dev->queues)) {
+         struct vkr_queue *queue =
+            list_first_entry(&dev->queues, struct vkr_queue, base.track_head);
+         const VkSubmitInfo submit = {
+            .sType = VK_STRUCTURE_TYPE_SUBMIT_INFO,
+            .signalSemaphoreCount = 1,
+            .pSignalSemaphores = &res_info->semaphore,
+         };
+         mtx_lock(&queue->vk_mutex);
+         result = vk->QueueSubmit(queue->base.handle.queue, 1, &submit, VK_NULL_HANDLE);
+         mtx_unlock(&queue->vk_mutex);
+      }
+      if (result != VK_SUCCESS) {
+         vkr_log("emulated semaphore import failed (vk ret %d)", result);
+         vkr_context_set_fatal(ctx);
+      }
+      return;
+   }
+
    const VkImportSemaphoreFdInfoKHR import_info = {
       .sType = VK_STRUCTURE_TYPE_IMPORT_SEMAPHORE_FD_INFO_KHR,
       .semaphore = res_info->semaphore,
