    args->ret = vk->CreateInstance(create_info, NULL, &instance->base.handle.instance);
+   pthread_mutex_unlock(&vkr_host_lifecycle_mutex);
    if (args->ret != VK_SUCCESS) {
       free(instance);
       return;
@@ -237,7 +239,7 @@ vkr_dispatch_vkCreateInstance(struct vn_dispatch_context *dispatch,
                                                          &instance->validation_messenger);
       if (args->ret != VK_SUCCESS) {
          struct vn_instance_proc_table *vk = &instance->proc_table;
-         vk->DestroyInstance(instance->base.handle.instance, NULL);
+         { pthread_mutex_lock(&vkr_host_lifecycle_mutex); vk->DestroyInstance(instance->base.handle.instance, NULL); pthread_mutex_unlock(&vkr_host_lifecycle_mutex); }
          free(instance);
          return;
       }
@@ -267,7 +269,7 @@ vkr_instance_destroy(struct vkr_context *ctx,
    }
 
    if (destroy_vk || ctx->on_worker_thread)
-      vk->DestroyInstance(instance->base.handle.instance, NULL);
+      { pthread_mutex_lock(&vkr_host_lifecycle_mutex); vk->DestroyInstance(instance->base.handle.instance, NULL); pthread_mutex_unlock(&vkr_host_lifecycle_mutex); }
 
    free(instance->physical_device_handles);
    free(instance->physical_devices);
