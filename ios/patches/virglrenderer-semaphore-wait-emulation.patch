--- a/src/venus/vkr_queue.c	2026-11-20 17:44:07.454974096 +0000
+++ b/src/venus/vkr_queue.c	2026-11-20 17:44:07.456334566 +0000
@@ -566,6 +566,54 @@
 
    vn_replace_vkWaitSemaphoreResourceMESA_args_handle(args);
 
+   if (dev->physical_device->is_semaphore_fd_emulated) {
+      /* Henge: no sync file export on this host (the device has no
+       * VK_KHR_external_semaphore_fd, so GetSemaphoreFdKHR is not there to call).
+       * Exporting takes the payload out of the semaphore; a submission that
+       * waits for it does the same. It is waited for, so the semaphore is no
+       * longer in use when the guest goes on to destroy or reuse it. */
+      VkResult result = VK_ERROR_UNKNOWN;
+      VkFence fence = VK_NULL_HANDLE;
+      if (!list_is_empty(&dev->queues)) {
+         struct vkr_queue *queue =
+            list_first_entry(&dev->queues, struct vkr_queue, base.track_head);
+         const VkFenceCreateInfo fence_info = {
+            .sType = VK_STRUCTURE_TYPE_FENCE_CREATE_INFO,
+         };
+         const VkPipelineStageFlags stage = VK_PIPELINE_STAGE_ALL_COMMANDS_BIT;
+         const VkSubmitInfo submit = {
+            .sType = VK_STRUCTURE_TYPE_SUBMIT_INFO,
+            .waitSemaphoreCount = 1,
+            .pWaitSemaphores = &args->semaphore,
+            .pWaitDstStageMask = &stage,
+         };
+         result = vk->CreateFence(args->device, &fence_info, NULL, &fence);
+         if (result == VK_SUCCESS) {
+            mtx_lock(&queue->vk_mutex);
+            result = vk->QueueSubmit(queue->base.handle.queue, 1, &submit, fence);
+            mtx_unlock(&queue->vk_mutex);
+         }
+         if (result == VK_SUCCESS) {
+            /* 3 s: a frame's drawing, with room; longer is a guest that never signals it */
+            result = vk->WaitForFences(args->device, 1, &fence, true, 3000000000ull);
+            if (result == VK_TIMEOUT) {
+               /* go on (the ring is not held up for good); the fence is still in
+                * use by the submission, so it is left, not destroyed */
+               vkr_log("emulated semaphore wait: not signaled after 3 s");
+               fence = VK_NULL_HANDLE;
+               result = VK_SUCCESS;
+            }
+         }
+         if (fence != VK_NULL_HANDLE)
+            vk->DestroyFence(args->device, fence, NULL);
+      }
+      if (result != VK_SUCCESS) {
+         vkr_log("emulated semaphore wait failed (vk ret %d)", result);
+         vkr_context_set_fatal(ctx);
+      }
+      return;
+   }
+
    const VkSemaphoreGetFdInfoKHR info = {
       .sType = VK_STRUCTURE_TYPE_SEMAPHORE_GET_FD_INFO_KHR,
       .semaphore = args->semaphore,
